# Локальные секреты для `wrangler dev`. Скопируйте в .dev.vars и заполните.
# В проде задаются через `bunx wrangler secret put <NAME>`.

# Вход администратора (репетитора)
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Ключ подписи JWT сессии: `openssl rand -base64 48`
JWT_SECRET=

# CSRF: origin локального фронта (в проде — vars в wrangler.jsonc)
ALLOWED_ORIGINS=http://localhost:5173

# Drizzle Kit (driver d1-http) — нужны только для `bun db:studio` против удалённой D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
