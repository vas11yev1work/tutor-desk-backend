{
  "name": "tutor-desk-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tutor-desk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tutor-desk-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "DB_LOCAL=1 drizzle-kit studio"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hono/standard-validator": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "nanoid": "^6.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "22",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2"
}
