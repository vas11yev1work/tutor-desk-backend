{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutor-desk-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Раз в сутки догенерировать регулярные занятия на 8 недель вперёд (scheduled в src/index.ts).
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "vars": {
    // Origin'ы фронта для CSRF-проверки (hono/csrf), через запятую. Перед деплоем добавить прод-домен.
    "ALLOWED_ORIGINS": "http://localhost:5173",
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tutor-desk-files",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutor-desk-db",
      "database_id": "56b13e49-b823-4ab3-a290-2fb40c52f199",
      "migrations_dir": "drizzle",
    },
  ],
}
